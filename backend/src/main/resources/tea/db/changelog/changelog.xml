<?xml version="1.0" encoding="UTF-8"?>
<!--
  Master changelog for the tea register.

  The FIRST include is not ours: it ships inside the published
  org.helex.emr:commons-db-core jar and creates the shared `core` schema.
  Our own DDL below depends on it, which is why it must come first.
-->
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

  <!-- Shared core schema, from the published commons-db-core jar. Idempotent. -->
  <include file="core-db/changelog/changelog.xml"/>

  <include file="tea/db/changelog/tea/changelog.xml"/>

  <includeAll path="library/db/changelog/" maxDepth="1" errorIfMissingOrEmpty="false"/>

</databaseChangeLog>
